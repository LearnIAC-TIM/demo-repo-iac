# =============================================================================
#  .gitignore  –  PÅ ROTA, FELLES FOR ALLE MODULMAPPENE
# -----------------------------------------------------------------------------
#  Mønstrene er uankrede, så de gjelder modul7/, modul8/ og backend/ likt.
#  Derfor ligger fila på rota og ikke i hver mappe.
#
#  Én linje er FJERNET i denne øvingen, og det er den viktigste endringen i
#  hele repoet utenom selve workflowen.
# =============================================================================
 
*.tfstate
*.tfstate.*
*.tfstate.backup
 
.terraform/
 
# .terraform.lock.hcl ER IKKE LENGER IGNORERT.
#
# Gjennom øving 1–6 spilte fila ingen rolle: .terraform/ lå på din disk
# mellom hver kjøring, så providerversjonen var allerede bestemt.
#
# En runner starter uten .terraform/. Uten låsefila i repoet står den fritt
# til å hente nyeste versjon innenfor ~> 5.4 – og da kan pipelinen gjøre noe
# annet enn du gjorde lokalt, uten at én linje kode er endret. Det er en av
# de mest frustrerende feilklassene som finnes: den oppstår uten at noen har
# gjort noe.
#
# Fila MÅ inneholde hasher for runnerens plattform. Kjør:
#
#   terraform providers lock \
#     -platform=linux_amd64 \
#     -platform=darwin_arm64 \
#     -platform=windows_amd64
#
# Hopper du over -platform, får fila bare hasher for din egen maskin, og
# runneren stopper på at pakken ikke matcher noen av dem.
 
# MERK: backend.hcl er heller ikke ignorert.
#
# Den inneholder navn på en ressursgruppe, en storage-konto og en container –
# ikke hemmeligheter. Navn er ikke tilgang. Og pipelinen trenger fila: tre
# jobber peker på den med -backend-config.
 
# Miljøfilene inneholder bare kortnavn, prosjektnavn og region.
#   dev.tfvars      ← sjekkes inn
#   prod.tfvars     ← sjekkes inn
 
*.tfplan
crash.log